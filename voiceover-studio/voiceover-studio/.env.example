# Paths default to this repository's data directory. Use absolute overrides.
# STUDIO_DATA_DIR=C:/VoiceoverStudio/data
STUDIO_QUEUE_MODE=local
STUDIO_DEVICE=auto
STUDIO_CPU_THREADS=4
# Local jobs share one process. Keep one render worker per GPU.
STUDIO_LOCAL_WORKERS=1
REDIS_URL=redis://127.0.0.1:6379/0
# FFMPEG_BIN=C:/Tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/Tools/ffmpeg/bin/ffprobe.exe
# Runtime never downloads weights. Run the setup scripts while online first.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
